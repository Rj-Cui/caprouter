{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caprouter.local/schemas/plan.schema.json",
  "title": "CapRouter Plan",
  "type": "object",
  "required": ["task_id", "goal", "nodes"],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 5 },
    "quality_gate": {
      "type": "object",
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "on_limit": { "type": "string", "enum": ["pause_and_report"] }
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "capability": {
            "type": "string",
            "enum": ["retrieve", "analyze", "generate", "transform", "verify", "format", "design", "operate_gui", "decide", "orchestrate"]
          },
          "domain": { "type": "string" },
          "brief": { "type": "string" },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "output_contract": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "format": { "type": "string" }
            },
            "additionalProperties": true
          },
          "acceptance": { "type": "array", "items": { "type": "string" } },
          "max_turns": { "type": "integer", "minimum": 1 },
          "top_k": { "type": "integer", "minimum": 1, "maximum": 10 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
