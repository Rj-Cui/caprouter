  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.md",
    ".claude-plugin/icon.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
